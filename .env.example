DATABASE_URL="postgres://localhost:3000"

ACCESS_TOKEN_SECRET="access_token_secret"
REFRESH_TOKEN_SECRET="refresh_token_secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
REFRESH_TOKEN_TTL_MS=604800000

# DEVELOPER FLAG: send complete error messages and stack traces in the responses (default: false).
# The API refuses to start with this flag when APP_STAGE=production.
EXPOSE_ERROR_DETAILS=false
