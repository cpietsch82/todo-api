DATABASE_URL="postgres://localhost:3000"

# at least 32 random characters in production, e.g. openssl rand -base64 48 (placeholders are rejected there)
ACCESS_TOKEN_SECRET="change-me-to-a-long-random-value-in-production"
# a number with a unit: s, m, h, d, w or y
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
REFRESH_TOKEN_TTL_MS=604800000
# maximum number of active refresh tokens (logins on different devices) per user, the oldest are removed
REFRESH_TOKEN_MAX_PER_USER=6

# DEVELOPER FLAG: send complete error messages and stack traces in the responses (default: false).
# It also sends the reason of a 403 (e.g. the missing permission), otherwise it is only logged.
# The API refuses to start with this flag when APP_STAGE=production.
EXPOSE_ERROR_DETAILS=false

# NUMBER OF REVERSE PROXIES IN FRONT OF THE API (default: 0 = none)
# Needed so the rate limits use the real client IP. Do not set it without a proxy, the IP could be forged.
# In docker compose the nginx of the frontend container is always one: 1 with only the frontend in front,
# 2 with Nginx Proxy Manager in front of it, 3 with Cloudflare + Nginx Proxy Manager.
TRUST_PROXY=0

# STRICTER RATE LIMITS FOR THE AUTH ROUTES (per IP, defaults shown)
# only failed login attempts are counted
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# failed login attempts per account (e-mail), whatever IP they come from
LOGIN_ACCOUNT_RATE_LIMIT_MAX=10
LOGIN_ACCOUNT_RATE_LIMIT_WINDOW_MS=900000
# requests to /auth/refresh and /auth/logout (each counted separately)
TOKEN_RATE_LIMIT_MAX=60
TOKEN_RATE_LIMIT_WINDOW_MS=900000
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
# invitations to todo lists per user, unknown usernames included
INVITATION_RATE_LIMIT_MAX=20
INVITATION_RATE_LIMIT_WINDOW_MS=3600000
# docker operations (pull, deploy, restart) of the admin area
DOCKER_OPERATION_RATE_LIMIT_MAX=10
DOCKER_OPERATION_RATE_LIMIT_WINDOW_MS=900000

# OPTIONAL: additionally write the logs to this rotated file (daily or at 10 MB, newest 14 kept). In docker the compose
# file sets /app/logs/api.log (the volume api_logs). Use a directory that only contains these logs.
# LOG_FILE=/app/logs/api.log

# VERSION OF THE API IMAGE (docker-compose.yml): the released version on the NAS (.env.api), "local" for development (.env)
API_IMAGE_TAG=0.0.1
