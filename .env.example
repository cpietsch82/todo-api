DATABASE_URL="postgres://localhost:3000"

ACCESS_TOKEN_SECRET="access_token_secret"
REFRESH_TOKEN_SECRET="refresh_token_secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
REFRESH_TOKEN_TTL_MS=604800000
# maximum number of active refresh tokens (logins on different devices) per user, the oldest are removed
REFRESH_TOKEN_MAX_PER_USER=6

# DEVELOPER FLAG: send complete error messages and stack traces in the responses (default: false).
# The API refuses to start with this flag when APP_STAGE=production.
EXPOSE_ERROR_DETAILS=false

# NUMBER OF REVERSE PROXIES IN FRONT OF THE API (default: 0 = none)
# Needed so the rate limits use the real client IP. Do not set it without a proxy, the IP could be forged.
TRUST_PROXY=0

# STRICTER RATE LIMITS FOR THE AUTH ROUTES (per IP, defaults shown)
# only failed login attempts are counted
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
