# Versions and updater settings of the docker compose stack on the NAS.
# Copy it to deploy.env next to docker-compose.yml and start every command with: docker compose --env-file deploy.env ...

# Version of the api. The updater changes this line when a deploy or rollback is requested through the admin api,
# so do not edit it while an operation is running.
API_IMAGE_TAG=0.0.3

# Version of the frontend (web app). For now only changed by hand, the updater only updates the api:
#   docker compose --env-file deploy.env pull frontend && docker compose --env-file deploy.env up -d frontend
FRONTEND_IMAGE_TAG=0.1.0

# Port of the NAS on which the frontend (and through it the api under /api) is reachable. The reverse proxy points here.
FRONTEND_PORT=8090

# Version of the updater itself, only changed by hand (the updater never updates itself).
UPDATER_IMAGE_TAG=0.0.1

# Absolute path of this folder on the system. The updater mounts it at exactly this path.
UPDATER_PROJECT_DIR=/volume1/docker/todo-api

# The docker login of the system (created by: docker login ghcr.io). The images on GHCR are public, so it is only
# needed when an image is made private; the file should exist anyway, otherwise docker creates a folder at this path.
UPDATER_DOCKER_CONFIG=/root/.docker/config.json
